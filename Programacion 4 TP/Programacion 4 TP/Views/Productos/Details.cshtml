@model Programacion_4_TP.Models.ProductoVM

@{
    ViewData["Title"] = "Details";
}

<h1>Detalle</h1>

<div>
    <h4>Producto @Html.DisplayFor(model => model.Nombre) </h4>
    <hr />
    <dl>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Nombre)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Nombre)
        </dd>
    </dl>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Precio)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Precio)
        </dd>
    </dl>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Cantidad)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Cantidad)
        </dd>
    </dl>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Id)
        </dt>
        <dd class="col-sm-10">
             @Html.DisplayFor(model => model.Id)
        </dd>
   </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.Id"class="btn btn-sm btn-outline-warning">Modificar</a>
    <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Volver</a>
</div>
