@model List<CarritoVM>

<h1>Mi carrito</h1>

@if (!Model.Any())
{
    <p>Tu carrito está vacío.</p>
}
else
{
    <table class="table">
        <thead>
            <tr><th>Producto</th><th>Precio</th><th>Cantidad</th><th>Subtotal</th><th></th></tr>
        </thead>
        <tbody>
            @foreach (var i in Model)
            {
                <tr>
                    <td>@i.Nombre</td>
                    <td>@i.Precio.ToString("C")</td>
                    <td>@i.Cantidad</td>
                    <td>@i.Subtotal.ToString("C")</td>
                    <td>
                        <form asp-action="Quitar" method="post" 
                        onsubmit="return confirm('¿Quitar este producto del carrito?');">
                            <input type="hidden" name="idCarrito" value="@i.IdCarrito"/>
                            <button class="btn btn-sm btn-outline-danger">Quitar</button>
                        </form>
                        <form asp-action="Comprar" method="post"
                              onsubmit="return confirm('¿Comprar el producto del carrito?');">
                            <input type="hidden" name="idCarrito" value="@i.IdCarrito"/>
                            <button class="btn btn-sm btn-outline-primary">Comprar</button>
                        </form>

                    </td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr>
                <th colspan="3" class="text-end">Total</th>
                <th>@Model.Sum(i => i.Subtotal).ToString("C")</th>
                <th></th>
            </tr>
        </tfoot>
    </table>
}